# =============================================================================
# .env.example — Template file. COMMIT this file.
# Copy to .env.local and fill in real values.
# DO NOT put real secrets in this file.
# =============================================================================

# ── API ──────────────────────────────────────────────────────────────────────
# URL of the APIX backend API (public — used in browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of this frontend (used for metadata, OG, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ── Feature flags (optional) ─────────────────────────────────────────────────
# NEXT_PUBLIC_FEATURE_AI=false

# =============================================================================
# Server-only variables (no NEXT_PUBLIC_ prefix)
# These are NEVER sent to the browser.
# =============================================================================

# Internal service token (server-to-server only)
# INTERNAL_API_SECRET=change-me
